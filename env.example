# Код подтверждения из настроек Callback API вашего сообщества VK
# (Управление сообществом -> Настройки -> Работа с API -> Callback API)
VK_CONFIRMATION_CODE=your_confirmation_code

# Секретный ключ (задаётся там же в настройках Callback API, необязателен, но желателен)
VK_SECRET_KEY=your_secret_key

# ID сообщества VK (число, без минуса), необязательно - для доп. проверки
VK_GROUP_ID=123456789

# Токен вашего Telegram-бота, полученный от @BotFather
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Ваш chat_id в Telegram (узнать через @userinfobot или getUpdates)
TG_CHAT_ID=123456789

# Порт, на котором слушает сервер (необязательно, по умолчанию 5000)
PORT=5000
